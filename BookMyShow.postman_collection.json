        {
          "name": "Create movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Movie\",\n  \"description\": \"A movie created from Postman.\",\n  \"language\": \"Tamil\",\n  \"genre\": \"Drama\",\n  \"durationMinutes\": 150,\n  \"releaseDate\": \"2026-09-01\",\n  \"castMembers\": [\n    \"Actor One\",\n    \"Actor Two\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"movieId\", pm.response.json().movie.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create show",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shows",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shows"
              ]
            },
            "description": "startsAt and endsAt are generated by the pre-request script: a random future day at 10:00, lasting 3 hours, so re-running does not clash with an existing show.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": {{movieId}},\n  \"theatreId\": {{theatreId}},\n  \"startsAt\": \"{{startsAt}}\",\n  \"endsAt\": \"{{endsAt}}\",\n  \"price\": 180,\n  \"seatRows\": [\n    \"A\",\n    \"B\",\n    \"C\"\n  ],\n  \"seatsPerRow\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date();",
                  "start.setDate(start.getDate() + 1 + Math.floor(Math.random() * 300));",
                  "start.setHours(10, 0, 0, 0);",
                  "const end = new Date(start.getTime() + 3 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set(\"startsAt\", start.toISOString());",
                  "pm.collectionVariables.set(\"endsAt\", end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"showId\", pm.response.json().show.id);"
                ]
              }
            }
          ]
        }
      ]
