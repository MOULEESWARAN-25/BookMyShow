            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"Passw0rd1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
