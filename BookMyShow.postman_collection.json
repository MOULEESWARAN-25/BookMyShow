{
  "info": {
    "name": "BookMyShow",
    "description": "BookMyShow API. Run the folders top to bottom: the login requests save adminToken and userToken, and the create requests save theatreId, movieId, showId and seatNumber for the requests after them. Seeded accounts use the password Passw0rd1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
